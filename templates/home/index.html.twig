{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}

    <div class="content-wrapper">
        <!-- En-tête de la page -->
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0 font-weight-bold">Bonjour, {{ app.user.firstName|default('Alassane') }} 👋</h1>
                        <p class="text-muted mb-0">Voici l'état de votre activité aujourd'hui.</p>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Logiciel</a></li>
                            <li class="breadcrumb-item active">Accueil</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contenu Principal -->
        <section class="content">
            <div class="container-fluid">

                <!-- SECTION 1 : LES CHIFFRES DU JOUR (Données réelles) -->
                <div class="row">
                    <!-- VALEUR DU STOCK -->
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-info">
                            <div class="inner">
                                <h3>{{ valeurStock|number_format(0, ',', ' ') }} <sup style="font-size: 20px">FCFA</sup></h3>
                                <p>Valeur totale du stock</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-boxes"></i>
                            </div>
                            <a href="{{ path('app_produit_article') }}" class="small-box-footer">Voir les produits <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <!-- TOTAL PRODUITS -->
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-success">
                            <div class="inner">
                                <h3>{{ totalProduits }}</h3>
                                <p>Produits référencés</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-cube"></i>
                            </div>
                            <a href="{{ path('app_produit_article') }}" class="small-box-footer">Voir le catalogue <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <!-- ENTREPÔTS -->
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-danger">
                            <div class="inner">
                                <h3>{{ totalEntrepots }}</h3>
                                <p>Entrepôts / Dépôts</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-warehouse"></i>
                            </div>
                            <a href="{{ path('app_entrepot') }}" class="small-box-footer">Voir les sites <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <!-- ALERTES STOCKS -->
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-warning">
                            <div class="inner">
                                <h3 class="text-white">{{ produitsAlerte }}</h3>
                                <p class="text-white">Articles en alerte de rupture</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <a href="{{ path('app_alert_rupture_stock') }}" class="small-box-footer" style="color: rgba(255,255,255,0.8) !important;">Voir les alertes <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                </div>

                <!-- SECTION 2 : PRODUITS LES PLUS EN STOCK -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="card card-outline card-primary">
                            <div class="card-header">
                                <h3 class="card-title font-weight-bold">
                                    <i class="fas fa-sort-amount-down text-primary mr-2"></i> Top Stock Physique
                                </h3>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover text-nowrap mb-0">
                                    <thead>
                                    <tr>
                                        <th style="width: 60%;">Produit</th>
                                        <th class="text-center">Quantité</th>
                                        <th class="text-right">Prix Unitaire</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for produit in produitsStock %}
                                        <tr>
                                            <td>
                                                <span class="font-weight-bold text-dark">{{ produit.libelle }}</span><br>
                                                <small class="text-muted font-mono">Ref: {{ produit.reference|default('-') }}</small>
                                            </td>
                                            <td class="text-center font-weight-bold">{{ produit.stockPhysique|default(0) }}</td>
                                            <td class="text-right">{{ produit.prixVente|number_format(0, ',', ' ') }} FCFA</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-4">Aucun produit en stock.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3 : DERNIERS MOUVEMENTS -->
                    <div class="col-md-6">
                        <div class="card card-outline card-info">
                            <div class="card-header">
                                <h3 class="card-title font-weight-bold">
                                    <i class="fas fa-history text-info mr-2"></i> Derniers Mouvements
                                </h3>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover text-nowrap mb-0">
                                    <thead>
                                    <tr>
                                        <th style="width: 35%;">Produit</th>
                                        <th>Type</th>
                                        <th class="text-center">Qté</th>
                                        <th class="text-right">Date</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for mvt in mouvementsRecents %}
                                        <tr>
                                            <td>
                                                <span class="font-weight-bold text-dark">{{ mvt.produit.libelle|default('-') }}</span>
                                            </td>
                                            <td>
                                                <span class="badge {% if mvt.typeMouvement == 'ENTREE_ACHAT' %}badge-success{% elseif mvt.typeMouvement == 'SORTIE_VENTE' %}badge-danger{% elseif mvt.typeMouvement == 'TRANSFERT' %}badge-warning{% else %}badge-info{% endif %} px-2 py-1 text-xs">
                                                    {{ mvt.typeMouvement|default('-') }}
                                                </span>
                                            </td>
                                            <td class="text-center">{{ mvt.quantite|default(0) }}</td>
                                            <td class="text-right text-muted text-xs">{{ mvt.createdAt|date('d/m/Y H:i')|default('-') }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">Aucun mouvement enregistré.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="card-footer bg-white text-right">
                                <a href="{{ path('app_stock_mouvement_index') }}" class="btn btn-sm btn-info font-weight-bold">
                                    Voir l'historique complet <i class="fas fa-arrow-right ml-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>

{% endblock %}
