{% extends 'base.html.twig' %}

{% block title %}Alertes de Rupture de Stock{% endblock %}

{% block body %}

    <div class="content-wrapper">
        <!-- En-tête de la page -->
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0 font-weight-bold"><i class="fas fa-exclamation-triangle text-warning mr-2"></i> Alertes de Rupture de Stock</h1>
                        <p class="text-muted mb-0">Produits dont le stock physique est inférieur ou égal au seuil d'alerte.</p>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                            <li class="breadcrumb-item active">Alertes Stock</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contenu Principal -->
        <section class="content">
            <div class="container-fluid">

                <!-- SECTION 1 : RÉSUMÉ DES ALERTES -->
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-12">
                        <div class="info-box bg-danger">
                            <span class="info-box-icon"><i class="fas fa-exclamation-triangle"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text font-weight-bold">Ruptures Urgentes</span>
                                <span class="info-box-number">{{ alertes|length }}</span>
                                <span class="progress-description text-sm">Stock <= seuil d'alerte</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6 col-12">
                        <div class="info-box bg-success">
                            <span class="info-box-icon"><i class="fas fa-check-circle"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text font-weight-bold">Stocks Sécurisés</span>
                                <span class="info-box-number">{{ stocksOk|length }}</span>
                                <span class="progress-description text-sm">Au-dessus du seuil</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6 col-12">
                        <div class="info-box bg-info">
                            <span class="info-box-icon"><i class="fas fa-question-circle"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text font-weight-bold">Sans Limite Définie</span>
                                <span class="info-box-number">{{ sansLimite|length }}</span>
                                <span class="progress-description text-sm">Aucun seuil configuré</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6 col-12">
                        <div class="info-box bg-warning text-dark">
                            <span class="info-box-icon"><i class="fas fa-warehouse"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text font-weight-bold">Total Produits</span>
                                <span class="info-box-number">{{ (alertes|length + stocksOk|length + sansLimite|length) }}</span>
                                <span class="progress-description text-sm">Référencés en base</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 2 : TABLEAU DES ALERTES -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card card-outline card-danger">
                            <div class="card-header">
                                <h3 class="card-title font-weight-bold text-danger">
                                    <i class="fas fa-bell mr-2"></i> Articles nécessitant votre attention
                                </h3>
                                <div class="card-tools">
                                    <a href="{{ path('app_produit_article') }}" class="btn btn-sm btn-outline-primary font-weight-bold">
                                        <i class="fas fa-cubes mr-1"></i> Voir le catalogue
                                    </a>
                                </div>
                            </div>

                            {% if alertes|length > 0 %}
                                <div class="card-body table-responsive p-0">
                                    <table class="table table-head-fixed table-hover text-nowrap align-middle mb-0">
                                        <thead class="bg-light">
                                        <tr>
                                            <th>Produit</th>
                                            <th>Stock Actuel</th>
                                            <th>Seuil d'Alerte</th>
                                            <th>Écart</th>
                                            <th>Prix Unitaire</th>
                                            <th>Valeur du Stock</th>
                                            <th class="text-center">Action</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for produit in alertes %}
                                            {% set ecart = produit.limitStock - produit.stockPhysique %}
                                            <tr class="table-danger">
                                                <td class="font-weight-bold text-dark">
                                                    <i class="fas fa-exclamation-triangle text-danger mr-2"></i>
                                                    {{ produit.libelle }}
                                                    <br><small class="text-muted font-mono">Ref: {{ produit.reference|default('-') }}</small>
                                                </td>
                                                <td class="font-weight-bold text-danger">{{ produit.stockPhysique|default(0) }}</td>
                                                <td class="font-weight-bold">{{ produit.limitStock|default(0) }}</td>
                                                <td class="font-weight-bold text-danger">-{{ ecart }}</td>
                                                <td>{{ produit.prixVente|number_format(0, ',', ' ') }} FCFA</td>
                                                <td class="font-weight-bold">{{ (produit.stockPhysique|default(0) * produit.prixVente|default(0))|number_format(0, ',', ' ') }} FCFA</td>
                                                <td class="text-center">
                                                    <a href="{{ path('details_entrepot', {'id': produit.id}) }}" class="btn btn-xs btn-warning font-weight-bold">
                                                        <i class="fas fa-eye mr-1"></i> Voir
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="card-body text-center py-5">
                                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                                    <h4 class="font-weight-bold text-success">Aucune alerte de rupture !</h4>
                                    <p class="text-muted">Tous vos produits sont au-dessus de leur seuil d'alerte.</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- SECTION 3 : ACTION RAPIDE - CORRECTION DE STOCK -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card card-outline card-info">
                            <div class="card-header bg-white">
                                <h3 class="card-title font-weight-bold text-dark">
                                    <i class="fas fa-tools text-info mr-2"></i> Régulariser un Stock
                                </h3>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info border-0 shadow-sm mb-0">
                                    <i class="fas fa-info-circle mr-2"></i>
                                    Pour corriger un stock manquant ou excédentaire, utilisez la fonction
                                    <strong>Correction / Ajustement d'Inventaire</strong> disponible dans l'onglet
                                    "Catalogue Articles" du module Logistique.
                                </div>
                                <a href="{{ path('app_produit_article') }}" class="btn btn-info btn-sm font-weight-bold mt-3">
                                    <i class="fas fa-boxes mr-1"></i> Aller au Catalogue
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>

{% endblock %}
