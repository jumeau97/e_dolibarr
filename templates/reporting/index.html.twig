{% extends 'base.html.twig' %}

{% block title %}Reporting Financier{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0 font-weight-bold text-dark">
                            <i class="fas fa-chart-pie text-indigo mr-2"></i> Reporting Financier
                        </h1>
                        <p class="text-muted mb-0">Suivez vos ventes et dépenses en temps réel.</p>
                    </div>
                    <div class="col-sm-6 text-right">
                        <form method="GET" class="form-inline">
                            <select name="mois" class="form-control form-control-sm d-inline-block w-auto mr-2">
                                {% for m in 1..12 %}
                                    <option value="{{ m }}" {{ m == mois ? 'selected' : '' }}>{{ 'janvier|février|mars|avril|mai|juin|juillet|août|septembre|octobre|novembre|décembre'|split('|')[m-1] }} {{ annee }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">Voir</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <!-- Cartes principales -->
                <div class="row">
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-success">
                            <div class="inner">
                                <h3>{{ totalVentesJour|number_format(0, ',', ' ') }}</h3>
                                <p>Ventes aujourd'hui</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-cash-register"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-danger">
                            <div class="inner">
                                <h3>{{ totalDepensesJour|number_format(0, ',', ' ') }}</h3>
                                <p>Dépenses aujourd'hui</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-arrow-circle-down"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-{{ soldeNetJour >= 0 ? 'success' : 'danger' }}">
                            <div class="inner">
                                <h3>{{ soldeNetJour|number_format(0, ',', ' ') }}</h3>
                                <p>Solde net jour</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-calculator"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-info">
                            <div class="inner">
                                <h3>{{ totalVentesMois|number_format(0, ',', ' ') }}</h3>
                                <p>Ventes ce mois</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-calendar"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-warning">
                            <div class="inner">
                                <h3>{{ totalDepensesMois|number_format(0, ',', ' ') }}</h3>
                                <p>Dépenses ce mois</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-file-invoice-dollar"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-{{ soldeNetMois >= 0 ? 'success' : 'danger' }}">
                            <div class="inner">
                                <h3>{{ soldeNetMois|number_format(0, ',', ' ') }}</h3>
                                <p>Solde net mois</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-money-check-alt"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <!-- Détail des ventes du mois -->
                    <div class="col-lg-6">
                        <div class="card card-outline card-success shadow-sm">
                            <div class="card-header bg-white">
                                <h3 class="card-title font-weight-bold text-dark">
                                    <i class="fas fa-shopping-cart mr-1"></i> Ventes du mois
                                </h3>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead>
                                    <tr>
                                        <th>N° Vente</th>
                                        <th>Date</th>
                                        <th class="text-right">Montant (FCFA)</th>
                                        <th>Mode</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for v in ventesMois %}
                                        <tr>
                                            <td>{{ v.numero }}</td>
                                            <td>{{ v.dateVente|date('d/m/Y H:i') }}</td>
                                            <td class="text-right">{{ v.montantTTC|number_format(0, ',', ' ') }}</td>
                                            <td>{{ v.modeReglement }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">Aucune vente ce mois.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Détail des dépenses du mois -->
                    <div class="col-lg-6">
                        <div class="card card-outline card-danger shadow-sm">
                            <div class="card-header bg-white">
                                <h3 class="card-title font-weight-bold text-dark">
                                    <i class="fas fa-receipt mr-1"></i> Dépenses du mois
                                </h3>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead>
                                    <tr>
                                        <th>Motif</th>
                                        <th class="text-center">Catégorie</th>
                                        <th class="text-right">Montant (FCFA)</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for d in depensesMois %}
                                        <tr>
                                            <td>{{ d.motif }}</td>
                                            <td class="text-center"><span class="badge badge-info">{{ d.categorie|default('-') }}</span></td>
                                            <td class="text-right">{{ d.montant|number_format(0, ',', ' ') }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-4">Aucune dépense ce mois.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dernières caisses -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card card-outline card-info shadow-sm">
                            <div class="card-header bg-white">
                                <h3 class="card-title font-weight-bold text-dark">
                                    <i class="fas fa-money-bill-wave mr-1"></i> Dernières Caisses
                                </h3>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead>
                                    <tr>
                                        <th>Date ouverture</th>
                                        <th>Statut</th>
                                        <th class="text-center">Solde initial</th>
                                        <th class="text-center">Solde final</th>
                                        <th>Utilisateur</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for c in caisses %}
                                        <tr>
                                            <td>{{ c.dateOuverture|date('d/m/Y H:i') }}</td>
                                            <td class="text-center">
                                                <span class="badge {% if c.statut == 'ouverte' %}badge-success{% else %}badge-danger{% endif %}">
                                                    {{ c.statut == 'ouverte' ? 'Ouverte' : 'Fermée' }}
                                                </span>
                                            </td>
                                            <td class="text-center">{{ c.soldeInitial|number_format(0, ',', ' ') }}</td>
                                            <td class="text-center">{{ c.soldeFinal|number_format(0, ',', ' ')|default('-') }}</td>
                                            <td>{{ c.utilisateur.firstName|default('-') }} {{ c.utilisateur.lastName|default('-') }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">Aucune caisse enregistrée.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
