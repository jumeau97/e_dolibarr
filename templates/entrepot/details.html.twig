{% extends 'base.html.twig' %}

{% block title %}Détails de l'Entrepôt : Dépôt Central{% endblock %}

{% block body %}
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0 font-weight-bold text-dark">
                                <i class="fas fa-warehouse text-indigo mr-2"></i> {{ entrepot.lieu }}
                            </h1>
                            <p class="text-muted text-sm mb-0">
                                <i class="fas fa-map-marker-alt mr-1"></i> {{ entrepot.address }}, {{ entrepot.town }}
                                | <i class="fas fa-phone ml-2 mr-1"></i> {{ entrepot.phone|default('Pas de contact') }}
                            </p>
                        </div>
                        <div class="col-sm-6 text-sm-right mt-2 mt-sm-0">
                            <a href="" class="btn btn-default btn-sm shadow-sm mr-2">
                                <i class="fas fa-arrow-left mr-1"></i> Retour à la liste
                            </a>
                            <button class="btn btn-indigo btn-sm shadow-sm" data-toggle="modal" data-target="#modal-edit-warehouse">
                                <i class="fas fa-edit mr-1"></i> Modifier le site
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <section class="content">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-3 col-sm-6 col-12">
                            <div class="info-box shadow-sm">
                        <span class="info-box-icon {% if entrepot.status == 'active' %}bg-success{% elseif entrepot.status == 'maintenance' %}bg-warning{% else %}bg-danger{% endif %} text-white">
                            <i class="fas fa-toggle-on"></i>
                        </span>
                                <div class="info-box-content">
                                    <span class="info-box-text text-muted text-xs text-uppercase font-weight-bold">Statut</span>
                                    <span class="info-box-number mt-1">
                                {% if entrepot.status == 'active' %}Opérationnel{% elseif entrepot.status == 'maintenance' %}Maintenance{% else %}Inactif{% endif %}
                            </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 col-12">
                            <div class="info-box shadow-sm">
                                <span class="info-box-icon bg-info text-white"><i class="fas fa-box"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text text-muted text-xs text-uppercase font-weight-bold">Références</span>
                                    <span class="info-box-number mt-1">{{ produits|length }} Articles</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 col-12">
                            <div class="info-box shadow-sm">
                                <span class="info-box-icon bg-indigo text-white"><i class="fas fa-boxes"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text text-muted text-xs text-uppercase font-weight-bold">Quantité Totale</span>
                                    {% set totalQuantite = 0 %}
                                    {% for p in produits %}{% set totalQuantite = totalQuantite + p.quantite|default(0) %}{% endfor %}
                                    <span class="info-box-number mt-1">{{ totalQuantite|number_format(0, ',', ' ') }} unités</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 col-12">
                            <div class="info-box shadow-sm">
                                <span class="info-box-icon bg-olive text-white"><i class="fas fa-percentage"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text text-muted text-xs text-uppercase font-weight-bold">Taux d'occupation</span>
                                    {# Exemple basé sur une capacité théorique de l'entité #}
                                    {% set capaciteMax = entrepot.capacity|default(10000) %}
                                    {% set taux = (totalQuantite / capaciteMax) * 100 %}
                                    <span class="info-box-number mt-1">{{ taux|number_format(1) }} %</span>
                                    <div class="progress progress-xs mt-1">
                                        <div class="progress-bar bg-olive" style="width: {{ taux }}%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card card-indigo card-tabs shadow-sm">
                                <div class="card-header p-0 pt-1 bg-white border-bottom">
                                    <ul class="nav nav-tabs" id="warehouseTab" role="tablist">
                                        <li class="nav-item">
                                            <a class="nav-link active text-dark font-weight-bold" id="stock-tab" data-toggle="pill" href="#tab-stock" role="tab">
                                                <i class="fas fa-cubes text-muted mr-1"></i> Stock Disponible
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark font-weight-bold" id="flux-tab" data-toggle="pill" href="#tab-flux" role="tab">
                                                <i class="fas fa-exchange-alt text-muted mr-1"></i> Mouvements de Stock
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark font-weight-bold" id="prediction-tab" data-toggle="pill" href="#tab-prediction" role="tab">
                                                <i class="fas fa-brain text-purple mr-1"></i> Prédictions IA (Python)
                                            </a>
                                        </li>
                                    </ul>
                                </div>

                                <div class="card-body p-0">
                                    <div class="tab-content" id="warehouseTabContent">

                                        <div class="tab-pane fade show active" id="tab-stock" role="tabpanel">
                                            <div class="table-responsive">
                                                <table class="table table-hover table-striped mb-0 text-nowrap align-middle">
                                                    <thead class="thead-light">
                                                    <tr>
                                                        <th>Référence</th>
                                                        <th>Désignation</th>
                                                        <th>Catégorie</th>
                                                        <th class="text-right">Prix de vente</th>
                                                        <th class="text-center">Quantité en stock</th>
                                                        <th class="text-center">État</th>
                                                    </tr>
                                                    </thead>
                                                    <tbody>
                                                    {% for product in produits %}
                                                        <tr>
                                                            <td class="font-mono text-xs font-weight-bold text-secondary">{{ product.reference }}</td>
                                                            <td><span class="font-weight-bold text-dark">{{ product.libelle }}</span></td>
                                                            <td>{{ product.category.libelle|default('Non classé') }}</td>
                                                            <td class="text-right font-weight-bold text-dark">{{ product.prixVente|number_format(0, ',', ' ') }} FCFA</td>
                                                            <td class="text-center font-weight-bold text-indigo">{{ product.quantite|default(0) }}</td>
                                                            <td class="text-center">
                                                                {% if product.quantite|default(0) <= product.limitStock|default(5) %}
                                                                    <span class="badge badge-pill bg-danger-light text-danger px-2 py-1">Alerte Rupture</span>
                                                                {% else %}
                                                                    <span class="badge badge-pill bg-success-light text-success px-2 py-1">Correct</span>
                                                                {% endif %}
                                                            </td>
                                                        </tr>
                                                    {% else %}
                                                        <tr>
                                                            <td colspan="6" class="text-center py-5 text-muted">
                                                                <i class="fas fa-box-open fa-2x mb-2"></i>
                                                                <p class="mb-0">Aucun produit stocké dans cet entrepôt pour le moment.</p>
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div class="tab-pane fade" id="tab-flux" role="tabpanel">
                                            <div class="p-4 text-center text-muted">
                                                <i class="fas fa-history fa-2x mb-2 text-gray"></i>
                                                <p class="mb-0">Le journal des mouvements de stock filtré pour <b>{{ entrepot.lieu }}</b> s'affichera ici.</p>
                                            </div>
                                        </div>

                                        <div class="tab-pane fade" id="tab-prediction" role="tabpanel">
                                            <div class="p-4">
                                                <div class="callout callout-info border-indigo shadow-sm mb-4">
                                                    <h5><i class="fas fa-magic text-indigo mr-2"></i> Module de Maintenance Préventive &amp; Réapprovisionnement</h5>
                                                    <p class="text-sm text-muted">Ce module communique directement avec vos scripts de machine learning en Python pour anticiper les ruptures de stock en fonction des tendances de ventes passées de ce site.</p>
                                                </div>

                                                <div class="text-center py-3">
                                                    <button type="button" class="btn btn-outline-indigo btn-sm" onclick="alert('Lancement de l\'analyse prédictive...');">
                                                        <i class="fas fa-sync-alt mr-1"></i> Calculer les prévisions pour le mois prochain
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById('table-search-stock');
            const rows = document.querySelectorAll('.item-row');

            // Filtre dynamique pour la table d'inventaire interne de l'entrepôt
            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                rows.forEach(row => {
                    const rowText = row.textContent.toLowerCase();
                    row.style.display = rowText.includes(query) ? "" : "none";
                });
            });
        });
    </script>
{% endblock %}