{% extends 'base.html.twig' %}

{% block title %}Caisse - Encaissement{% endblock %}

{% block stylesheets %}
    <style>
        .product-grid {
            max-height: 65vh;
            overflow-y: auto;
        }
        .cart-table-container {
            max-height: 55vh;
            overflow-y: auto;
        }
        .product-card {
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .product-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15) !important;
        }
        .product-card.stock-alert {
            border-left: 4px solid #dc3545;
        }
        .product-card.stock-ok {
            border-left: 4px solid #28a745;
        }
        .ticket-printed {
            border: 2px solid #28a745;
            background: #f8f9fa;
        }
        .qty-input {
            width: 60px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <!-- En-tête de la page -->
        <div class="content-header py-2">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-sm-6">
                        <h1 class="m-0 font-weight-bold text-dark">
                            <i class="fas fa-cash-register text-indigo mr-2"></i> Comptoir &amp; Encaissement
                        </h1>
                    </div>
                    <div class="col-sm-6 text-right">
                        <span class="badge badge-success p-2 shadow-sm">
                            <i class="fas fa-dot-circle mr-1 animate-pulse"></i> Mode Caisse Dynamique
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contenu Principal -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">

                    <!-- ZONE GAUCHE : PRODUITS & PANIER -->
                    <div class="col-lg-8 col-md-12 mb-3">
                        <div class="card card-outline card-indigo shadow-sm">
                            <div class="card-header bg-white py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="input-group" style="width: 300px;">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                                        </div>
                                        <input type="text" id="search-product" class="form-control form-control-lg" placeholder="Rechercher un article ou sa référence...">
                                    </div>
                                    <span id="produits-count" class="badge badge-info"></span>
                                </div>
                            </div>

                            <!-- Liste de produits depuis l'API -->
                            <div class="card-body product-grid bg-light p-3">
                                <div class="row" id="products-list">
                                    <!-- Produits injectés par JavaScript -->
                                </div>
                                <div id="products-empty" class="col-12 text-center text-muted py-5" style="display:none;">
                                    <i class="fas fa-box-open fa-2x mb-2"></i>
                                    <p>Aucun produit disponible.</p>
                                </div>
                                <div id="products-loading" class="col-12 text-center py-5">
                                    <i class="fas fa-circle-notch fa-spin fa-2x text-primary mb-2"></i>
                                    <p>Chargement des produits...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ZONE DROITE : PANIER ACTIF & RÈGLEMENT -->
                    <div class="col-lg-4 col-md-12">

                        <!-- Le Panier -->
                        <div class="card card-dark shadow-sm mb-3">
                            <div class="card-header bg-dark">
                                <h3 class="card-title font-weight-bold"><i class="fas fa-shopping-basket mr-2"></i> Panier de vente</h3>
                                <div class="card-tools">
                                    <button type="button" class="btn btn-tool" id="clear-cart" title="Vider tout le panier"><i class="fas fa-trash-alt text-danger"></i></button>
                                </div>
                            </div>

                            <div class="card-body p-0 cart-table-container bg-white">
                                <table class="table table-striped table-valign-middle m-0" id="cart-table">
                                    <thead class="thead-light">
                                    <tr>
                                        <th>Article</th>
                                        <th style="width: 60px;">Qté</th>
                                        <th class="text-right">Prix Un.</th>
                                        <th class="text-right">Total</th>
                                        <th style="width: 40px;"></th>
                                    </tr>
                                    </thead>
                                    <tbody id="cart-table-body">
                                    <tr id="empty-cart-row">
                                        <td colspan="5" class="text-center text-muted py-5">
                                            <i class="fas fa-cart-plus fa-2x mb-2 text-gray d-block"></i>
                                            Cliquez sur un article pour l'ajouter
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Calculs financiers finaux -->
                        <div class="card card-outline card-dark shadow-sm">
                            <div class="card-body bg-light">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted">Sous-total brut :</span>
                                    <span class="font-weight-bold text-dark" id="summary-subtotal">0 FCFA</span>
                                </div>

                                <div class="row mb-3 align-items-center">
                                    <div class="col-6">
                                        <span class="text-muted">Remise appliquée :</span>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group input-group-sm">
                                            <input type="number" id="discount-input" value="0" min="0" step="100" class="form-control text-right font-weight-bold text-danger qty-input">
                                            <div class="input-group-append">
                                                <span class="input-group-text bg-white">FCFA</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-2">

                                <div class="d-flex justify-content-between align-items-center bg-dark text-white p-3 rounded shadow-sm my-3">
                                    <h5 class="m-0 font-weight-bold">NET À PAYER :</h5>
                                    <h3 class="m-0 font-weight-bold text-warning" id="summary-total">0 FCFA</h3>
                                </div>

                                <!-- Choix du règlement -->
                                <div class="form-group mb-3">
                                    <label class="text-xs text-muted text-uppercase font-weight-bold">Mode de règlement :</label>
                                    <div class="btn-group btn-group-toggle d-flex" data-toggle="buttons">
                                        <label class="btn btn-outline-secondary active flex-fill py-2">
                                            <input type="radio" name="pay_opt" value="Especes" checked> <i class="fas fa-money-bill-wave d-block mb-1"></i> Espèces
                                        </label>
                                        <label class="btn btn-outline-secondary flex-fill py-2">
                                            <input type="radio" name="pay_opt" value="Mobile"> <i class="fas fa-mobile-alt d-block mb-1"></i> Mobile
                                        </label>
                                        <label class="btn btn-outline-secondary flex-fill py-2">
                                            <input type="radio" name="pay_opt" value="Cheque"> <i class="fas fa-credit-card d-block mb-1"></i> Chèque
                                        </label>
                                    </div>
                                </div>

                                <!-- Calcul de monnaie -->
                                <div class="row bg-white p-2 rounded border mx-0 mb-3">
                                    <div class="col-6">
                                        <div class="form-group mb-0">
                                            <label class="text-xs text-muted mb-0">Montant Reçu</label>
                                            <input type="number" id="amount-received" class="form-control form-control-sm font-weight-bold text-success text-lg border-0 p-0" placeholder="0" style="font-size: 1.3rem;">
                                        </div>
                                    </div>
                                    <div class="col-6 text-right d-flex flex-column justify-content-center">
                                        <span class="text-xs text-muted">Monnaie à rendre</span>
                                        <h4 class="font-weight-bold text-danger m-0" id="change-to-return">0 FCFA</h4>
                                    </div>
                                </div>

                                <!-- Bouton de validation -->
                                <div class="d-grid">
                                    <button type="button" class="btn btn-success btn-lg font-weight-bold shadow-sm py-3" id="btn-validate-sale" disabled>
                                        <i class="fas fa-print mr-2"></i> Valider l'encaissement
                                    </button>
                                </div>

                                <div class="mt-2" id="ticket-container" style="display:none;">
                                    <div class="card card-success ticket-printed">
                                        <div class="card-header bg-success text-white">
                                            <h5 class="card-title"><i class="fas fa-ticket-alt mr-2"></i> Ticket de Vente</h5>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="row mb-2">
                                                <div class="col-6"><strong>N° :</strong> <span id="ticket-numero"></span></div>
                                                <div class="col-6 text-right"><strong>Date :</strong> <span id="ticket-date"></span></div>
                                            </div>
                                            <hr>
                                            <div id="ticket-lignes"></div>
                                            <hr>
                                            <div class="row">
                                                <div class="col-6"><strong>Total :</strong></div>
                                                <div class="col-6 text-right"><strong id="ticket-total">0 FCFA</strong></div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-6"><strong>Caissier :</strong></div>
                                                <div class="col-6 text-right"><strong id="ticket-caissier"></strong></div>
                                            </div>
                                        </div>
                                        <div class="card-footer">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-new-sale">
                                                <i class="fas fa-plus mr-1"></i> Nouvelle vente
                                            </button>
                                            <button type="button" class="btn btn-primary btn-sm" id="btn-print-ticket">
                                                <i class="fas fa-print mr-1"></i> Imprimer
                                            </button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </section>
    </div>

    <!-- Modal de confirmation -->
    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="confirmModalTitle">Confirmation</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" id="confirmModalBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-primary" id="confirmModalAction">Confirmer</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const productsList = document.getElementById('products-list');
            const productsEmpty = document.getElementById('products-empty');
            const productsLoading = document.getElementById('products-loading');
            const searchInput = document.getElementById('search-product');
            const cartTableBody = document.querySelector('#cart-table tbody');
            const emptyCartRow = document.getElementById('empty-cart-row');
            const clearCartBtn = document.getElementById('clear-cart');
            const produitsCount = document.getElementById('produits-count');

            const subtotalEl = document.getElementById('summary-subtotal');
            const totalEl = document.getElementById('summary-total');
            const discountInput = document.getElementById('discount-input');
            const amountReceivedInput = document.getElementById('amount-received');
            const changeToReturnEl = document.getElementById('change-to-return');
            const btnValidateSale = document.getElementById('btn-validate-sale');
            const ticketContainer = document.getElementById('ticket-container');
            const btnNewSale = document.getElementById('btn-new-sale');

            // Ticket elements
            const ticketNumero = document.getElementById('ticket-numero');
            const ticketDate = document.getElementById('ticket-date');
            const ticketLignes = document.getElementById('ticket-lignes');
            const ticketTotal = document.getElementById('ticket-total');
            const ticketCaissier = document.getElementById('ticket-caissier');

            let produits = [];
            let cart = [];

            // Charger les produits depuis l'API
            async function chargerProduits() {
                try {
                    const response = await fetch("{{ path('api_vente_produits') }}");
                    const result = await response.json();
                    if (result.status === 1 && result.data) {
                        produits = result.data;
                        afficherProduits(produits);
                        produitsCount.textContent = produits.length + ' article(s)';
                    } else {
                        produitsEmpty.style.display = 'block';
                        produitsLoading.style.display = 'none';
                    }
                } catch (e) {
                    console.error('Erreur chargement produits:', e);
                    produitsEmpty.style.display = 'block';
                    produitsLoading.style.display = 'none';
                }
            }

            function afficherProduits(liste) {
                productsList.innerHTML = '';
                productsLoading.style.display = 'none';

                if (!liste || liste.length === 0) {
                    productsEmpty.style.display = 'block';
                    return;
                }
                productsEmpty.style.display = 'none';

                liste.forEach(p => {
                    const estAlerte = p.stockPhysique <= (p.limitStock || 0);
                    const cardClass = estAlerte ? 'stock-alert' : 'stock-ok';
                    const badgeClass = estAlerte ? 'badge-danger' : 'badge-success';
                    const badgeText = estAlerte ? p.stockPhysique + ' (Alerte)' : p.stockPhysique + ' en stock';

                    const col = document.createElement('div');
                    col.className = 'col-xl-4 col-md-6 mb-3 product-item';
                    col.setAttribute('data-id', p.id);
                    col.setAttribute('data-libelle', p.libelle);
                    col.setAttribute('data-prix', p.prixVente);
                    col.setAttribute('data-stock', p.stockPhysique);

                    col.innerHTML = `
                        <div class="card h-100 m-0 shadow-sm product-card ${cardClass}">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <span class="text-xs text-muted d-block">Ref: ${p.reference || '-'}</span>
                                    <h6 class="font-weight-bold text-dark my-1">${p.libelle}</h6>
                                    <small class="text-muted d-block">Stock: ${p.stockPhysique}</small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="badge ${badgeClass}">${badgeText}</span>
                                    <span class="text-md font-weight-bold text-indigo">${Number(p.prixVente).toLocaleString('fr-FR')} F</span>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-2 add-to-cart">
                                    <i class="fas fa-plus mr-1"></i> Ajouter
                                </button>
                            </div>
                        </div>
                    `;

                    col.querySelector('.add-to-cart').addEventListener('click', () => ajouterAuPanier(p));
                    col.querySelector('.product-card').addEventListener('click', (e) => {
                        if (!e.target.classList.contains('add-to-cart') && !e.target.classList.contains('fa-plus')) {
                            ajouterAuPanier(p);
                        }
                    });

                    productsList.appendChild(col);
                });
            }

            function ajouterAuPanier(produit) {
                const existing = cart.find(item => item.id === produit.id);
                if (existing) {
                    if (existing.quantite >= produit.stockPhysique) {
                        showAlert('Stock insuffisant pour ajouter davantage de "' + produit.libelle + '".');
                        return;
                    }
                    existing.quantite++;
                } else {
                    cart.push({
                        id: produit.id,
                        libelle: produit.libelle,
                        reference: produit.reference,
                        prix: parseFloat(produit.prixVente),
                        stockPhysique: produit.stockPhysique,
                        quantite: 1
                    });
                }
                renderCart();
            }

            function renderCart() {
                cartTableBody.innerHTML = '';

                if (cart.length === 0) {
                    cartTableBody.appendChild(emptyCartRow);
                    btnValidateSale.disabled = true;
                    updateTotals(0);
                    return;
                }

                btnValidateSale.disabled = false;
                let subtotal = 0;

                cart.forEach((item, index) => {
                    const itemTotal = item.prix * item.quantite;
                    subtotal += itemTotal;

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="py-2">
                            <span class="font-weight-bold d-block text-truncate text-sm" style="max-width: 160px;">${item.libelle}</span>
                            <small class="text-muted d-block">Ref: ${item.reference || '-'}</small>
                        </td>
                        <td class="py-1">
                            <input type="number" class="form-control form-control-sm text-center qty-input change-qty" data-index="${index}" value="${item.quantite}" min="1" max="${item.stockPhysique}" style="height: 26px; width: 60px;">
                        </td>
                        <td class="text-right text-sm py-2">${item.prix.toLocaleString('fr-FR')}</td>
                        <td class="text-right font-weight-bold text-sm py-2">${itemTotal.toLocaleString('fr-FR')}</td>
                        <td class="text-center py-2">
                            <button type="button" class="btn btn-xs text-danger remove-item" data-index="${index}">
                                <i class="fas fa-times-circle"></i>
                            </button>
                        </td>
                    `;
                    cartTableBody.appendChild(tr);
                });

                updateTotals(subtotal);
            }

            function updateTotals(subtotal) {
                const discount = parseFloat(discountInput.value) || 0;
                const total = Math.max(0, subtotal - discount);

                subtotalEl.textContent = subtotal.toLocaleString('fr-FR') + ' FCFA';
                totalEl.textContent = total.toLocaleString('fr-FR') + ' FCFA';
                calculateChange(total);
            }

            function calculateChange(totalNet) {
                const received = parseFloat(amountReceivedInput.value) || 0;
                const change = received - totalNet;

                if (change >= 0 && totalNet > 0) {
                    changeToReturnEl.textContent = change.toLocaleString('fr-FR') + ' FCFA';
                    changeToReturnEl.className = "font-weight-bold text-success m-0";
                } else {
                    changeToReturnEl.textContent = '0 FCFA';
                    changeToReturnEl.className = "font-weight-bold text-danger m-0";
                }
            }

            // Événements panier
            cartTableBody.addEventListener('input', function(e) {
                if (e.target.classList.contains('change-qty')) {
                    const index = e.target.getAttribute('data-index');
                    const newQty = parseInt(e.target.value) || 1;
                    const maxQty = parseInt(e.target.getAttribute('max'));
                    if (newQty > maxQty) {
                        e.target.value = maxQty;
                        cart[index].quantite = maxQty;
                    } else {
                        cart[index].quantite = newQty;
                    }
                    renderCart();
                }
            });

            cartTableBody.addEventListener('click', function(e) {
                const btn = e.target.closest('.remove-item');
                if (btn) {
                    const index = btn.getAttribute('data-index');
                    cart.splice(index, 1);
                    renderCart();
                }
            });

            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                const filtered = produits.filter(p =>
                    (p.libelle || '').toLowerCase().includes(query) ||
                    (p.reference || '').toLowerCase().includes(query)
                );
                afficherProduits(filtered);
            });

            discountInput.addEventListener('input', () => {
                const subtotal = cart.reduce((sum, item) => sum + (item.prix * item.quantite), 0);
                updateTotals(subtotal);
            });

            amountReceivedInput.addEventListener('input', () => {
                const totalNet = parseFloat(totalEl.textContent.replace(/[^0-9]/g, '')) || 0;
                calculateChange(totalNet);
            });

            clearCartBtn.addEventListener('click', function() {
                cart = [];
                renderCart();
            });

            // Validation de la vente (persistance en BD)
            btnValidateSale.addEventListener('click', async function() {
                if (cart.length === 0) return;

                const totalNet = parseFloat(totalEl.textContent.replace(/[^0-9]/g, '')) || 0;
                const received = parseFloat(amountReceivedInput.value) || 0;
                if (received < totalNet) {
                    showAlert('Le montant reçu est insuffisant.');
                    return;
                }

                const modeReglement = document.querySelector('input[name="pay_opt"]:checked').value;
                const discount = parseFloat(discountInput.value) || 0;

                btnValidateSale.disabled = true;
                btnValidateSale.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-2"></i> Traitement...';

                try {
                    const response = await fetch("{{ path('api_vente_valider') }}", {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({
                            lignes: cart.map(item => ({
                                produit_id: item.id,
                                quantite: item.quantite
                            })),
                            remise: discount,
                            mode_reglement: modeReglement
                        })
                    });

                    const result = await response.json();

                    if (result.status === 1) {
                        // Succès - afficher le ticket
                        afficherTicket(result.data);
                        cart = [];
                        renderCart();
                        discountInput.value = 0;
                        amountReceivedInput.value = '';
                        // Recharger les produits pour avoir les stocks à jour
                        await chargerProduits();
                    } else {
                        showAlert(result.message || 'Erreur lors de la validation de la vente.');
                        btnValidateSale.disabled = false;
                        btnValidateSale.innerHTML = '<i class="fas fa-print mr-2"></i> Valider l\'encaissement';
                    }
                } catch (e) {
                    console.error(e);
                    showAlert('Erreur de connexion lors de la validation.');
                    btnValidateSale.disabled = false;
                    btnValidateSale.innerHTML = '<i class="fas fa-print mr-2"></i> Valider l\'encaissement';
                }
            });

            btnNewSale.addEventListener('click', function() {
                ticketContainer.style.display = 'none';
                btnValidateSale.disabled = false;
                btnValidateSale.innerHTML = '<i class="fas fa-print mr-2"></i> Valider l\'encaissement';
            });

            function afficherTicket(data) {
                const now = new Date();
                ticketNumero.textContent = data.numero;
                ticketDate.textContent = now.toLocaleDateString('fr-FR') + ' ' + now.toLocaleTimeString('fr-FR', {hour: '2-digit', minute:'2-digit'});
                ticketTotal.textContent = Number(data.montantTTC).toLocaleString('fr-FR') + ' FCFA';
                ticketCaissier.textContent = "{{ app.user.firstName|default('Caissier') }} {{ app.user.lastName|default('') }}";

                ticketLignes.innerHTML = '';
                cart.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'd-flex justify-content-between mb-1';
                    row.innerHTML = `
                        <span>${item.libelle} x${item.quantite}</span>
                        <span>${(item.prix * item.quantite).toLocaleString('fr-FR')} F</span>
                    `;
                    ticketLignes.appendChild(row);
                });

                ticketContainer.style.display = 'block';
                // Auto-impression (optionnel)
                // window.print();
            }

            function showAlert(message) {
                const body = document.getElementById('confirmModalBody');
                body.textContent = message;
                const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
                document.getElementById('confirmModalAction').style.display = 'none';
                modal.show();
                setTimeout(() => modal.hide(), 2000);
            }

            // Initialisation
            chargerProduits();
        });
    </script>
{% endblock %}
