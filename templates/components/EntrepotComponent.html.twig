            <div class="row">
                <div class="col-12 table-responsive">
                    <table class="table table-hover table-striped mb-0 text-nowrap">
                        <thead class="bg-dark">
                        <tr>
                            <th>Nom du dépôt / Boutique</th>
                            <th>Localisation / Description</th>
                            <th>Volume d'articles stockés</th>
                            <th class="text-right">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entrepot in this.PagedData.items %}
                            <tr>
                                <td><b>{{ entrepot.lieu }}</b></td>
                                <td>{{ entrepot.description|default('Aucune description') }}</td>
                                <td><span class="badge badge-info">1 450 articles</span></td>
                                <td class="text-right">
                                    <button class="btn btn-xs btn-primary shadow-sm"><i class="fas fa-eye mr-1"></i>
                                        Voir le stock
                                    </button>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center py-5 bg-white">
                                    <div class="text-muted">
                                        <i class="fas fa-warehouse fa-3x mb-3 text-gray-300"></i>
                                        <p class="mb-2">Aucun entrepôt ne correspond à votre recherche
                                            "<strong>{{ searchQuery }}</strong>".</p>
                                        <button class="btn btn-xs btn-outline-primary shadow-sm"
                                                data-action="live#update"
                                                data-model="searchQuery"
                                                data-value="">
                                            <i class="fas fa-times mr-1"></i> Effacer le filtre
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# BLOC PAGINATION #}
            {% if this.PagedData.totalItemCount > 0 %}
                <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2">
        <span class="text-xs text-muted">
            Total : <b>{{ this.PagedData.totalItemCount }}</b> site(s) trouvé(s)
        </span>

                    <ul class="pagination pagination-sm m-0">
                        {# Bouton PRÉCÉDENT #}
                        <li class="page-item {{ currentPage <= 1 ? 'disabled' }}">
                            <button class="page-link"
                                    data-action="live#update"
                                    data-model="currentPage"
                                    data-value="{{ currentPage - 1 }}"
                                    {{ currentPage <= 1 ? 'disabled' }}>
                                &laquo;
                            </button>
                        </li>

                        {# BOUCLE DES PAGES #}
                        {% for i in 1..this.PagedData.totalPage %}
                            <li class="page-item {{ i == currentPage ? 'active' }}">
                                <button class="page-link {{ i == currentPage ? 'bg-indigo border-indigo' }}"
                                        data-action="live#update"
                                        data-model="currentPage"
                                        data-value="{{ i }}">
                                    {{ i }}
                                </button>
                            </li>
                        {% endfor %}

                        {# Bouton SUIVANT #}
                        <li class="page-item {{ currentPage >= this.PagedData.totalPage ? 'disabled' }}">
                            <button class="page-link"
                                    data-action="live#update"
                                    data-model="currentPage"
                                    data-value="{{ currentPage + 1 }}"
                                    {{ currentPage >= this.PagedData.totalPage ? 'disabled' }}>
                                &raquo;
                            </button>
                        </li>
                    </ul>
                </div>
            {% endif %}

        </div>
    </section>
</div>





