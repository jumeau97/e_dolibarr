<div{{ attributes }}>
    <section class="content">
        <div class="container-fluid">

            <div class="card card-outline card-indigo shadow-sm mt-3">
                <div class="card-header bg-white py-3">
                    <h3 class="card-title font-weight-bold text-dark mt-1">
                        <i class="fas fa-warehouse text-muted mr-2"></i> Gestion des Entrepôts
                    </h3>
                    <div class="card-tools">
                        <div class="input-group input-group-sm" style="width: 280px;">
                            <input type="text" name="table_search" data-model="searchQuery"
                                   class="form-control float-right"
                                   placeholder="Rechercher par lieu, ville, description...">

                            <div class="input-group-append">
                                <button data-action="live#update"
                                        data-model="searchQuery"
                                        data-value=""
                                        type="button" class="btn btn-default">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /.card-header -->

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 text-nowrap">
                            <thead class="bg-dark text-white">
                            <tr>
                                <th>Nom du dépôt / Boutique</th>
                                <th>Localisation / Description</th>
                                <th>Volume d'articles stockés</th>
                                <th class="text-right">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for entrepot in this.pagedData.items %}
                                <tr>
                                    <td><b>{{ entrepot.lieu }}</b></td>
                                    <td>{{ entrepot.description|default('Aucune description') }}</td>
                                    <td>
                                        <span class="badge badge-info">
                                            {{ entrepot.produits|length }} article(s)
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <a href="{{ path('details_entrepot', {'id': entrepot.id}) }}"
                                           class="btn btn-xs btn-primary shadow-sm">
                                            <i class="fas fa-eye mr-1"></i> Voir le stock
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-5 bg-white">
                                        <div class="text-muted">
                                            <i class="fas fa-warehouse fa-3x mb-3 text-gray-300"></i>
                                            <p class="mb-2">Aucun entrepôt ne correspond à votre recherche
                                                "<strong>{{ searchQuery }}</strong>".</p>
                                            <button class="btn btn-xs btn-outline-primary shadow-sm"
                                                    data-action="live#update"
                                                    data-model="searchQuery"
                                                    data-value="">
                                                <i class="fas fa-times mr-1"></i> Effacer le filtre
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# BLOC PAGINATION #}
                {% if this.pagedData.totalItemCount > 0 %}
                    <div class="card-footer clearfix bg-white border-top py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-xs text-muted">
                                Total : <b>{{ this.pagedData.totalItemCount }}</b> site(s) trouvé(s)
                            </span>

                            <ul class="pagination pagination-sm m-0">
                                {# Bouton PRÉCÉDENT #}
                                <li class="page-item {{ this.pagedData.currentPageNumber <= 1 ? 'disabled' }}">
                                    <button class="page-link"
                                            data-action="live#update"
                                            data-model="currentPage"
                                            data-value="{{ this.pagedData.currentPageNumber - 1 }}"
                                            {{ this.pagedData.currentPageNumber <= 1 ? 'disabled' }}>
                                        &laquo;
                                    </button>
                                </li>

                                {# BOUCLE DES PAGES #}
                                {% for i in 1..this.pagedData.totalPage %}
                                    <li class="page-item {{ i == this.pagedData.currentPageNumber ? 'active' }}">
                                        <button class="page-link {{ i == this.pagedData.currentPageNumber ? 'bg-indigo border-indigo' }}"
                                                data-action="live#update"
                                                data-model="currentPage"
                                                data-value="{{ i }}">
                                            {{ i }}
                                        </button>
                                    </li>
                                {% endfor %}

                                {# Bouton SUIVANT #}
                                <li class="page-item {{ this.pagedData.currentPageNumber >= this.pagedData.totalPage ? 'disabled' }}">
                                    <button class="page-link"
                                            data-action="live#update"
                                            data-model="currentPage"
                                            data-value="{{ this.pagedData.currentPageNumber + 1 }}"
                                            {{ this.pagedData.currentPageNumber >= this.pagedData.totalPage ? 'disabled' }}>
                                        &raquo;
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                {% endif %}
            </div>

        </div>
    </section>
</div>
