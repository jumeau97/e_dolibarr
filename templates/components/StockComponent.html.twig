<div{{ attributes }}>
    <section class="content">
        <div class="container-fluid">
            <div class="card card-outline card-indigo shadow-sm mt-3">

                <!-- ENTÊTE AVEC FILTRE RECHERCHE LIVE -->
                <div class="card-header bg-white py-3">
                    <h3 class="card-title font-weight-bold text-dark mt-1">
                        <i class="fas fa-cubes text-muted mr-2"></i> Vue Instantanée du Stock
                    </h3>
                    <div class="card-tools">
                        <div class="input-group input-group-sm" style="width: 280px;">
                            <input type="text"
                                   data-model="searchQuery"
                                   class="form-control float-right"
                                   placeholder="Filtrer par réf, libellé, catégorie...">
                            <div class="input-group-append">
                                <button type="button" class="btn btn-default"
                                        data-action="live#update"
                                        data-model="searchQuery"
                                        data-value="">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CORPS DU TABLEAU DYNAMIQUE -->
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 text-center align-middle">
                            <thead class="bg-light text-sm text-dark">
                            <tr>
                                <th class="text-left">Réf.</th>
                                <th class="text-left">Libellé</th>
                                <th class="text-left">Catégorie</th>
                                <th>Seuil alerte</th>
                                <th>Stock optimal</th>
                                <th class="text-indigo font-weight-bold">Stock physique</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for product in this.stockList.items %}
                                <tr>
                                    <!-- Réf. -->
                                    <td class="text-left font-mono text-sm">
                                        {{ product.reference|default('-') }}
                                    </td>

                                    <!-- Libellé -->
                                    <td class="text-left text-dark">
                                        {{ product.libelle|default('-') }}
                                    </td>

                                    <!-- Catégorie -->
                                    <td class="text-left">
                                        <span class="badge badge-light border text-secondary text-sm">
                                            {{ product.category.libelle|default('Non classé') }}
                                        </span>
                                    </td>

                                    <!-- Seuil alerte -->
                                    <td>
                                        <span class="badge badge-warning-light text-warning px-2 py-1">
                                            {{ product.stockAlerte|default(0) }}
                                        </span>
                                    </td>

                                    <!-- Stock optimal -->
                                    <td>
                                        <span class="text-muted">{{ product.stockOptimal|default(0) }}</span>
                                    </td>

                                    <!-- Stock physique -->
                                    <td class="font-weight-bold {% if product.stockPhysique|default(0) <= product.stockAlerte|default(0) %}text-danger{% else %}text-indigo{% endif %}">
                                        {{ product.stockPhysique|default(0) }}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-boxes fa-2x mb-2 text-gray-300"></i>
                                        <p class="mb-0">Aucun produit trouvé dans le catalogue de stock.</p>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- FOOTER AVEC PAGINATION REACTIVE -->
                {% if this.stockList.totalItemCount > 0 %}
                    <div class="card-footer clearfix bg-white border-top py-2">
                        <ul class="pagination pagination-sm m-0 float-right">
                            {# Bouton Précédent #}
                            <li class="page-item {{ this.stockList.currentPageNumber <= 1 ? 'disabled' }}">
                                <button class="page-link"
                                        data-action="live#update"
                                        data-model="currentPage"
                                        data-value="{{ this.stockList.currentPageNumber - 1 }}"
                                        {{ this.stockList.currentPageNumber <= 1 ? 'disabled' }}>&laquo;</button>
                            </li>

                            {# Boucle des Pages #}
                            {% for i in 1..this.stockList.totalPage %}
                                <li class="page-item {{ i == this.stockList.currentPageNumber ? 'active' }}">
                                    <button class="page-link {{ i == this.stockList.currentPageNumber ? 'bg-indigo border-indigo' }}"
                                            data-action="live#update"
                                            data-model="currentPage"
                                            data-value="{{ i }}">{{ i }}</button>
                                </li>
                            {% endfor %}

                            {# Bouton Suivant #}
                            <li class="page-item {{ this.stockList.currentPageNumber >= this.stockList.totalPage ? 'disabled' }}">
                                <button class="page-link"
                                        data-action="live#update"
                                        data-model="currentPage"
                                        data-value="{{ this.stockList.currentPageNumber + 1 }}"
                                        {{ this.stockList.currentPageNumber >= this.stockList.totalPage ? 'disabled' }}>&raquo;</button>
                            </li>
                        </ul>

                        {# Indicateur de lignes #}
                        <span class="text-muted text-xs float-left mt-2">
                            Total : <b>{{ this.stockList.totalItemCount }}</b> référence(s) en stock
                        </span>
                    </div>
                {% endif %}

            </div>
        </div>
    </section>
</div>
