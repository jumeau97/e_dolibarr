<div{{ attributes }}>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <button type="button" class="btn btn-primary btn-sm shadow-sm" data-toggle="modal"
                                        data-target="#modal-add-user">
                                    <i class="fas fa-user-plus mr-1"></i> Nouveau membre
                                </button>
                            </h3>

                            <div class="card-tools">
                                <div class="input-group input-group-sm" style="width: 400px;">
                                    <input type="text" name="table_search" data-model="searchQuery"
                                           class="form-control float-right"
                                           placeholder="Nom, e-mail...">

                                    <div class="input-group-append">
                                        <button data-action="live#update"
                                                data-model="searchQuery"
                                                data-value=""
                                                type="button" class="btn btn-default">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                <tr>
                                    <th>Prénom & Nom</th>
                                    <th>E-mail</th>
                                    <th>Rôles</th>
                                    <th class="text-center">Téléphone</th>
                                    <th class="text-center">État</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for user in this.pagedData.items %}
                                    <tr>
                                        <td>
                                            <span class="text-primary"><i class="fas fa-user-circle mr-1"></i></span>
                                            <strong>{{ user.firstName|default('-') }}</strong> {{ user.lastName|upper|default('-') }}
                                        </td>
                                        <td>{{ user.email }}</td>
                                        <td>
                                            {% for role in user.roles %}
                                                {% if role == 'ROLE_ADMINISTRATEUR' or role == 'ROLE_ADMIN' %}<span
                                                    class="badge badge-danger">Administrateur</span>
                                                {% elseif role == 'ROLE_FORMATEUR' %}<span class="badge badge-warning">Formateur</span>
                                                {% elseif role == 'ROLE_APPRENANT' %}<span class="badge badge-warning">Apprenant</span>
                                                {% else %}<span class="badge badge-primary">{{ role }}</span>
                                                {% endif %}
                                            {% endfor %}
                                        </td>
                                        <td class="text-center">{{ user.phoneNumber|default('-') }}</td>
                                        <td class="text-center">
                                            {% if user.state %}
                                                <span class="badge badge-success">Actif</span>
                                            {% else %}
                                                <span class="badge badge-secondary">Inactif</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <a href="{{ path('user_list') }}"
                                               class="btn btn-xs btn-outline-info shadow-sm"
                                               title="Voir les utilisateurs">
                                                <i class="fas fa-user"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="fas fa-users-slash fa-3x mb-3 opacity-50"></i>
                                                <p class="lead">Aucun utilisateur trouvé pour
                                                    "<strong>{{ searchQuery }}</strong>"</p>
                                                <button class="btn btn-sm btn-primary" data-action="live#update"
                                                        data-model="searchQuery" data-value="">
                                                    Réinitialiser la recherche
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {% if this.pagedData.totalItemCount > 0 %}
                            <div class="card-footer clearfix bg-white border-top py-2">
                                <ul class="pagination pagination-sm m-0 float-right">
                                    <li class="page-item {{ this.pagedData.currentPageNumber <= 1 ? 'disabled' }}">
                                        <button class="page-link" data-action="live#update" data-model="currentPage"
                                                data-value="{{ this.pagedData.currentPageNumber - 1 }}"
                                                {{ this.pagedData.currentPageNumber <= 1 ? 'disabled' }}>
                                            &laquo;
                                        </button>
                                    </li>

                                    {% for i in 1..this.pagedData.totalPage %}
                                        <li class="page-item {{ i == this.pagedData.currentPageNumber ? 'active' }}">
                                            <button class="page-link" data-action="live#update"
                                                    data-model="currentPage"
                                                    data-value="{{ i }}">{{ i }}</button>
                                        </li>
                                    {% endfor %}

                                    <li class="page-item {{ this.pagedData.currentPageNumber >= this.pagedData.totalPage ? 'disabled' }}">
                                        <button class="page-link" data-action="live#update"
                                                data-model="currentPage"
                                                data-value="{{ this.pagedData.currentPageNumber + 1 }}"
                                                {{ this.pagedData.currentPageNumber >= this.pagedData.totalPage ? 'disabled' }}>
                                            &raquo;
                                        </button>
                                    </li>
                                </ul>

                                <span class="text-muted text-xs float-left mt-2">
                                    Total : <b>{{ this.pagedData.totalItemCount }}</b> utilisateur(s)
                                </span>
                            </div>
                        {% endif %}
                    </div>
                    <!-- /.card -->
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>
</div>
