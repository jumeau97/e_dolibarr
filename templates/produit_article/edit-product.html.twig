{% extends 'base.html.twig' %}

{% block title %}Modifier le produit{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0 font-weight-bold text-dark">
                            <i class="fas fa-pencil-alt text-indigo mr-2"></i> Modifier le produit
                        </h1>
                    </div>
                    <div class="col-sm-6 text-right">
                        <a href="{{ path('app_produit_article') }}" class="btn btn-sm btn-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Retour au catalogue
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="card card-outline card-indigo shadow-sm">
                    <div class="card-header bg-white">
                        <h3 class="card-title font-weight-bold text-dark">
                            <i class="fas fa-box mr-1"></i> {{ produit.libelle }} ({{ produit.reference }})
                        </h3>
                    </div>
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.reference) }}
                                {{ form_row(form.libelle) }}
                                {{ form_row(form.category) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.prixAchat) }}
                                {{ form_row(form.prixVente) }}
                                {{ form_row(form.limitStock) }}
                                {{ form_row(form.stockOptimal) }}
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                {{ form_row(form.entrepots) }}
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-12 text-right">
                                <a href="{{ path('app_produit_article') }}" class="btn btn-sm btn-secondary mr-2">Annuler</a>
                                <button type="submit" class="btn btn-sm btn-indigo">
                                    <i class="fas fa-save mr-1"></i> Enregistrer les modifications
                                </button>
                            </div>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
