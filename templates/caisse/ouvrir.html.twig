{% extends 'base.html.twig' %}

{% block title %}Ouvrir la caisse{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0 font-weight-bold text-dark">
                            <i class="fas fa-unlock text-success mr-2"></i> Ouverture de Caisse
                        </h1>
                    </div>
                    <div class="col-sm-6 text-right">
                        <a href="{{ path('app_caisse') }}" class="btn btn-sm btn-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> Retour
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card card-outline card-success shadow-sm">
                            <div class="card-header bg-white">
                                <h3 class="card-title font-weight-bold text-dark">
                                    <i class="fas fa-money-bill-wave mr-1"></i> Ouvrir une nouvelle caisse
                                </h3>
                            </div>
                            <div class="card-body">
                                {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
                                <div class="form-group">
                                    {{ form_label(form.soldeInitial) }}
                                    {{ form_widget(form.soldeInitial, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.soldeInitial) }}
                                </div>
                                <div class="form-group mt-4">
                                    <button type="submit" class="btn btn-success btn-lg btn-block font-weight-bold">
                                        <i class="fas fa-unlock mr-2"></i> Ouvrir la caisse
                                    </button>
                                </div>
                                {{ form_end(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
